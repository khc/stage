# Cloud Run Job image for one ADK agent app (agents/<APP>/src/main.ts):
#   docker build -f docker/Dockerfile.agents --build-arg APP=generic -t stage-generic .
#   docker build -f docker/Dockerfile.agents --build-arg APP=poet -t stage-poet .
# The HTTP service image is ./docker/Dockerfile.service.
# Runtime configuration is supplied only via environment variables at execution
# time; nothing is baked in: TASK_ID (required UUID), Firestore project/credentials, AGENT_MODEL and GOOGLE_GENAI_USE_VERTEXAI (optional),
# and the Gemini credentials. With the argument `register` the container records
# its agents for the job named by JOB_NAME instead of running a task.
ARG BUN_BUILD_IMAGE=oven/bun:1.4.4-slim
ARG BUN_IMAGE=oven/bun:1.4.4-distroless

FROM ${BUN_BUILD_IMAGE} AS deps
ARG APP
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/agents/package.json ./packages/agents/package.json
COPY packages/http/package.json ./packages/http/package.json
COPY agents/generic/package.json ./agents/generic/package.json
COPY agents/poet/package.json ./agents/poet/package.json
COPY apps/extract-service/package.json ./apps/extract-service/package.json
COPY apps/service/package.json ./apps/service/package.json
RUN bun install --frozen-lockfile --production --filter "./agents/${APP}" \
 && find node_modules \( -name "*.map" -o -name "*.d.ts" -o -name "*.d.mts" -o -name "*.d.cts" -o -name "*.md" \) -delete

FROM ${BUN_IMAGE} AS runtime
ARG APP
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY packages/agents ./packages/agents
COPY packages/http ./packages/http
COPY --from=deps /app/packages/agents/node_modules ./packages/agents/node_modules
COPY --from=deps /app/packages/http/node_modules ./packages/http/node_modules
# A fixed path: exec-form ENTRYPOINT cannot expand ARG, and the distroless image
# has no shell to create a symlink. It sits two levels below /app, like
# agents/<APP>, so the relative workspace symlinks in node_modules still resolve.
# Extra arguments (such as `register`) must still reach the program.
COPY agents/${APP} ./agents/current
COPY --from=deps /app/agents/${APP}/node_modules ./agents/current/node_modules

USER 1000:1000
ENTRYPOINT ["bun", "--preload", "/app/packages/agents/src/telemetry-init.ts", "/app/agents/current/src/main.ts"]
