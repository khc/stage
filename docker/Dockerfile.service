# HTTP service image (apps/service, the Elysia service). The agent job images
# are built from ./docker/Dockerfile.agents.
# Runtime configuration is supplied via environment variables, nothing is baked in:
# GCP_PROJECT and GCP_REGION (required), PORT (optional, default 3000 here), EXTRACT_URL,
# PUBSUB_TOPIC and PLATFORM_EVENTS_TOPIC (optional: without them the document routes and /events
# answer 501 and session messages serve only stored events).
ARG BUN_BUILD_IMAGE=oven/bun:1.4.4-slim
ARG BUN_IMAGE=oven/bun:1.4.4-distroless

FROM ${BUN_BUILD_IMAGE} AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/agents/package.json ./packages/agents/package.json
COPY packages/http/package.json ./packages/http/package.json
COPY agents/generic/package.json ./agents/generic/package.json
COPY agents/poet/package.json ./agents/poet/package.json
COPY apps/extract-service/package.json ./apps/extract-service/package.json
COPY apps/service/package.json ./apps/service/package.json
RUN bun install --frozen-lockfile --production --filter "./apps/service" \
 && find node_modules \( -name "*.map" -o -name "*.d.ts" -o -name "*.d.mts" -o -name "*.d.cts" -o -name "*.md" \) -delete

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app
# The service listens on loopback by default; a container must listen on every interface.
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY packages/agents ./packages/agents
COPY packages/http ./packages/http
COPY apps/service ./apps/service
COPY --from=deps /app/packages/agents/node_modules ./packages/agents/node_modules
COPY --from=deps /app/packages/http/node_modules ./packages/http/node_modules
COPY --from=deps /app/apps/service/node_modules ./apps/service/node_modules

USER 1000:1000
EXPOSE 3000
# The distroless image's entrypoint is `bun`; the preload registers the tracer provider (see
# apps/service/src/telemetry-init.ts).
ENTRYPOINT ["bun", "--preload", "/app/apps/service/src/telemetry-init.ts"]
CMD ["apps/service/src/index.ts"]
