# Copy to terraform.tfvars (gitignored) and fill in.
project                 = "your-dev-gcp-project"
region                  = "us-central1"
foundation_state_bucket = "your-terraform-state-bucket"
foundation_state_prefix = "stage/dev/foundation"

image_prefix     = "us-central1-docker.pkg.dev/your-dev-gcp-project/stage--containers--ar-dev/"
image_tag        = "1.0.0" # pin a version or sha256: digest, not latest
extract_invokers = []

deploy_service       = false
scheduler_target_url = null # https://... when deploy_service = true
service_invokers     = []   # e.g. ["serviceAccount:ui@your-dev-gcp-project.iam.gserviceaccount.com"]
