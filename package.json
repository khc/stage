{
  "name": "stage",
  "private": true,
  "workspaces": [
    "apps/*",
    "agents/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun --filter @stage/service start",
    "dev": "bun --filter '@stage/*' dev",
    "dev:service": "bun --filter @stage/service dev",
    "dev:ui": "bun --filter @stage/ui dev",
    "test": "bun test",
    "typecheck": "bun check scripts && bun --filter '*' typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/run": "^4.2.0",
    "@types/bun": "latest",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
