{
  "name": "stage",
  "private": true,
  "workspaces": [
    "apps/*",
    "agents/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "bun --filter @stage/control-service start",
    "dev": "bun --filter '@stage/*' dev",
    "dev:service": "bun --filter @stage/control-service dev",
    "dev:ui": "bun --filter @stage/ui dev",
    "eval": "bun --filter @stage/evals eval",
    "test": "bun test",
    "typecheck": "bun check scripts && bun --filter '*' typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@clack/prompts": "^1.9.0",
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/run": "^4.2.0",
    "@types/bun": "^1.4.4",
    "listr2": "^11.4.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@google/genai": "2.32.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "google-gax": "6.17.0"
  }
}
