# Copy to .env (gitignored) and fill in. Bun loads .env automatically; docker compose reads it
# for variable substitution. Put real secrets in .env only, never here.

# --- HTTP service (apps/control-service) ---
GCP_PROJECT=floci-local
GCP_REGION=us-central1
# Cloud Run jobs the service may run: comma-separated names, or * for any job (local only).
AGENT_JOBS=*
# PORT=3000

# --- Agent jobs ---
# Gemini credential (GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY also work).
GEMINI_API_KEY=
# Optional Exa web search key. task tf:apply passes it to the local knowledge job.
# EXA_API_KEY=
# Project id for the Firestore client when running locally.
GOOGLE_CLOUD_PROJECT=floci-local
# Model. Leave unset for the default. GOOGLE_GENAI_USE_VERTEXAI=true selects Vertex AI express mode.
# AGENT_MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=

# --- Local emulators (Floci). Uncomment only while `docker compose up -d` is running:
# with FIRESTORE_EMULATOR_HOST set, `bun test` also runs the Firestore contract tests,
# which fail if Floci is down. Without them the clients use the real Google Cloud APIs
# and need Application Default Credentials.
# FIRESTORE_EMULATOR_HOST=localhost:4588
# CLOUD_RUN_EMULATOR_HOST=localhost:4588
# PUBSUB_EMULATOR_HOST=localhost:4588

# --- Event streaming (Pub/Sub) ---
# Topic the agent jobs publish session events to; the service streams them at
# GET /tasks/:taskId/sessions/:sessionId/messages. Without it, only stored events are served.
# PUBSUB_TOPIC=agent-events
# Topic the service publishes platform events to and streams from GET /events (501 without it).
# PLATFORM_EVENTS_TOPIC=platform-events

# --- Document extraction ---
# apps/extract-service (a Cloud Run service in Floci: `task tf:create-extract` prints its URL).
# Without it the document routes answer 501.
# EXTRACT_URL=
# On GCP only: the audience for the Google ID token the service sends to extract.
# EXTRACT_AUDIENCE=

# --- Quick agent runs ---
# The agents' quick hosts (Cloud Run services of the agent images, `agent_service_apps` in infra):
# a JSON object of job name to service URL. `terraform -chdir=infra/envs/local output -raw agent_services`
# prints it. Without it every quick run is unavailable and agents run as jobs only.
# AGENT_SERVICES='{"generic-agents":"http://..."}'
# QUICK_BUDGET_MS=60000

# --- Task schedules (Cloud Scheduler) ---
# Base URL that Cloud Scheduler calls to run a task: this service, as Floci's container reaches it.
# Run the service on the host (`bun run dev:service`) for this address to work. Without it the
# schedule routes answer 501.
# SCHEDULER_TARGET_URL=http://host.docker.internal:3000
# On GCP only: the service account Scheduler signs its ID token as. Unset for Floci.
# SCHEDULER_INVOKER=

# --- Telemetry (ADK OpenTelemetry -> MLflow from `docker compose up -d mlflow`, UI on http://localhost:5001) ---
# `task tf:apply` passes every OTEL_* variable to the agent jobs; they reach the host through
# host.docker.internal. Create an experiment in the MLflow UI and use its id below (0 = Default).
# Traces only: the generic OTEL_EXPORTER_OTLP_ENDPOINT would also enable metrics and logs exporters.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:5001/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-mlflow-experiment-id=0

# --- Ingestion (packages/ingestion: docs -> chunks -> embeddings -> Qdrant, plus a catalog file) ---
# Setting QDRANT_URL, or EMBEDDING_URL and EMBEDDING_MODEL, also turns on the contract tests in
# `bun test`, which fail while that server is down (like the Floci block above).
# Qdrant from `docker compose up -d qdrant`, and the collection the chunks go into.
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=docs
# Without an api key, Qdrant answers any caller on this machine, and a web page can still reach it
# through DNS rebinding (CORS off only blocks cross-origin reads). The key is the protection: set the
# same value twice, QDRANT__SERVICE__API_KEY (read by docker compose, then recreate the container)
# and QDRANT_API_KEY (sent by the client). Never set either to an empty value. Use an https
# QDRANT_URL for any Qdrant that is not on this machine, since the key travels in a header.
# QDRANT__SERVICE__API_KEY=
# QDRANT_API_KEY=
# An OpenAI-compatible embeddings server (oMLX on the host) and the model it serves. Needed to
# ingest and search; `fetch` and `ingest --dry-run` work without them.
# EMBEDDING_URL=http://127.0.0.1:8000
# EMBEDDING_MODEL=Qwen3-Embedding-0.6B-8bit
# EMBEDDING_API_KEY=
# Text added before each document / query, for models that expect an instruction (Qwen3-Embedding
# wants one on the query only). A literal \n is a newline.
# EMBEDDING_DOCUMENT_PREFIX=
# EMBEDDING_QUERY_PREFIX="Instruct: Given a question about technical documentation, retrieve the passages that answer it\nQuery: "
# Optional cross-encoder reranker (oMLX /v1/rerank). Leave RERANK_URL/RERANK_API_KEY unset to reuse
# EMBEDDING_URL/EMBEDDING_API_KEY (recommended so host 127.0.0.1 and Floci host.docker.internal both
# resolve). Setting RERANK_MODEL also enables the reranker contract test in `bun test`.
# RERANK_URL=
# RERANK_MODEL=Qwen3-Reranker-0.6B-mxfp8
# RERANK_API_KEY=
# The knowledge agent's job (agents/knowledge) reads QDRANT_API_KEY, EMBEDDING_MODEL, EMBEDDING_API_KEY,
# EMBEDDING_QUERY_PREFIX, RERANK_MODEL and RERANK_API_KEY from here through `task tf:apply`; its URLs
# and the `docs` collection are Terraform variables (host.docker.internal), not read from this file.
# Characters per chunk, and the overlap between the pieces of a block larger than a chunk.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=100
# Where the fetched docs and the catalog files go, relative to packages/ingestion.
# OUT_DIR=out/ingestion

# --- Neo4j graph discovery (packages/ingestion catalog & agents/knowledge) ---
# Neo4j 5.26+ from `docker compose up -d neo4j` (HTTP Query API v2 on 7474).
# Setting NEO4J_URL also turns on the Neo4j contract tests in `bun test`.
# NEO4J_URL=http://localhost:7474
# NEO4J_DATABASE=neo4j
# NEO4J_USER=neo4j
# Set a password in .env before starting `docker compose up -d neo4j`.
# NEO4J_PASSWORD=
# PostgreSQL connection string or Floci container name for RDBMS metadata ingestion (`ingest imdb`).
# Leave IMDB_DATABASE_URL unset to query Floci's Postgres container via `docker exec`.
# IMDB_DATABASE_URL=postgres://imdb_reader:imdb-reader-local@localhost:5432/imdb
# IMDB_CONTAINER=floci-gcp-cloudsql-floci-local-imdb
