# Copy to .env (gitignored) and fill in. Bun loads .env automatically; docker compose reads it
# for variable substitution. Put real secrets in .env only, never here.

# --- HTTP service (apps/service) ---
GCP_PROJECT=floci-local
GCP_REGION=us-central1
# Cloud Run jobs the service may run: comma-separated names, or * for any job (local only).
AGENT_JOBS=*
# PORT=3000

# --- Agent jobs ---
# Gemini credential (GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY also work).
GEMINI_API_KEY=
# Project id for the Firestore client when running locally.
GOOGLE_CLOUD_PROJECT=floci-local
# Model. Leave unset for the default. GOOGLE_GENAI_USE_VERTEXAI=true selects Vertex AI express mode.
# AGENT_MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=

# --- Local emulators (Floci). Uncomment only while `docker compose up -d` is running:
# with FIRESTORE_EMULATOR_HOST set, `bun test` also runs the Firestore contract tests,
# which fail if Floci is down. Without them the clients use the real Google Cloud APIs
# and need Application Default Credentials.
# FIRESTORE_EMULATOR_HOST=localhost:4588
# CLOUD_RUN_EMULATOR_HOST=localhost:4588
# PUBSUB_EMULATOR_HOST=localhost:4588

# --- Event streaming (Pub/Sub) ---
# Topic the agent jobs publish session events to; the service streams them at
# GET /tasks/:taskId/sessions/:sessionId/messages. Without it, only stored events are served.
# PUBSUB_TOPIC=agent-events
# Topic the service publishes platform events to and streams from GET /events (501 without it).
# PLATFORM_EVENTS_TOPIC=platform-events

# --- Document extraction ---
# apps/extract-service (a Cloud Run service in Floci: `task tf:create-extract` prints its URL).
# Without it the document routes answer 501.
# EXTRACT_URL=
# On GCP only: the audience for the Google ID token the service sends to extract.
# EXTRACT_AUDIENCE=

# --- Task schedules (Cloud Scheduler) ---
# Base URL that Cloud Scheduler calls to run a task: this service, as Floci's container reaches it.
# Run the service on the host (`bun run dev:service`) for this address to work. Without it the
# schedule routes answer 501.
# SCHEDULER_TARGET_URL=http://host.docker.internal:3000
# On GCP only: the service account Scheduler signs its ID token as. Unset for Floci.
# SCHEDULER_INVOKER=

# --- Telemetry (ADK OpenTelemetry -> MLflow from `docker compose up -d mlflow`, UI on http://localhost:5001) ---
# `task tf:apply` passes every OTEL_* variable to the agent jobs; they reach the host through
# host.docker.internal. Create an experiment in the MLflow UI and use its id below (0 = Default).
# Traces only: the generic OTEL_EXPORTER_OTLP_ENDPOINT would also enable metrics and logs exporters.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:5001/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=x-mlflow-experiment-id=0
