# HTTP service image (apps/service-deprecated, the Hono service, replaced by apps/service). The agent job images are built from ./Dockerfile.agents.
# Runtime configuration is supplied via environment variables, nothing is baked
# in: GCP_PROJECT and GCP_REGION (required), PORT (optional, default 3000 in this image; 3001 outside it),
# AGENT_MODEL and GOOGLE_GENAI_USE_VERTEXAI (optional) and the Gemini credentials.
ARG BUN_BUILD_IMAGE=oven/bun:1.4.4-slim
ARG BUN_IMAGE=oven/bun:1.4.4-distroless

FROM ${BUN_BUILD_IMAGE} AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/agents/package.json ./packages/agents/package.json
COPY agents/generic/package.json ./agents/generic/package.json
COPY agents/poet/package.json ./agents/poet/package.json
COPY apps/extract/package.json ./apps/extract/package.json
COPY apps/service-deprecated/package.json ./apps/service-deprecated/package.json
RUN bun install --frozen-lockfile --production --filter "./apps/service-deprecated" \
 && find node_modules \( -name "*.map" -o -name "*.d.ts" -o -name "*.d.mts" -o -name "*.d.cts" -o -name "*.md" \) -delete

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY packages/agents ./packages/agents
COPY apps/service-deprecated ./apps/service-deprecated
COPY --from=deps /app/packages/agents/node_modules ./packages/agents/node_modules
COPY --from=deps /app/apps/service-deprecated/node_modules ./apps/service-deprecated/node_modules

USER 1000:1000
EXPOSE 3000
CMD ["apps/service-deprecated/src/index.ts"]
