# Dashboard image (apps/ui): static Vite build served by nginx on port 8080, which
# proxies the API paths to SERVICE_URL (default http://host.docker.internal:3000).
ARG BUN_IMAGE=oven/bun:1.4.4-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine

FROM ${BUN_IMAGE} AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/agents/package.json ./packages/agents/package.json
COPY agents/generic/package.json ./agents/generic/package.json
COPY agents/poet/package.json ./agents/poet/package.json
COPY apps/extract/package.json ./apps/extract/package.json
COPY apps/service/package.json ./apps/service/package.json
COPY apps/ui/package.json ./apps/ui/package.json
RUN bun install --frozen-lockfile
# The UI's API types come from the service (`import type { App } from "@stage/service/app"`), so
# the type check in the build needs the service sources and what they import.
COPY packages/agents ./packages/agents
COPY apps/service ./apps/service
COPY apps/ui ./apps/ui
RUN cd apps/ui && bun run build

FROM ${NGINX_IMAGE} AS runtime
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1 SERVICE_URL=http://host.docker.internal:3000 NGINX_ENVSUBST_FILTER="SERVICE_URL|NGINX_LOCAL_RESOLVERS"
COPY apps/ui/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY apps/ui/api-proxy.conf /etc/nginx/api-proxy.conf
COPY --from=build /app/apps/ui/dist /usr/share/nginx/html
EXPOSE 8080
