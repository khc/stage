# Cloud Run Job image for the ADK agent (apps/agent/src/main.ts). The HTTP service
# image is ./Dockerfile.service.
# Runtime configuration is supplied only via environment variables at execution
# time; nothing is baked in: TASK_ID (required UUID), Firestore project/credentials, AGENT_MODEL and GOOGLE_GENAI_USE_VERTEXAI (optional),
# and the Gemini credentials.
ARG BUN_IMAGE=oven/bun:1.4.4-slim

FROM ${BUN_IMAGE} AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/agent/package.json ./apps/agent/package.json
COPY apps/service/package.json ./apps/service/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN bun install --frozen-lockfile --production

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY apps/agent ./apps/agent
COPY --from=deps /app/apps/agent/node_modules ./apps/agent/node_modules

USER bun
ENTRYPOINT ["bun", "apps/agent/src/main.ts"]
