# Standalone web dashboard image (apps/web).
# Runtime configuration is supplied via environment variables:
# WEB_PORT or PORT (optional, default 3001), SERVICE_URL (optional, default http://localhost:3000).
ARG BUN_IMAGE=oven/bun:1.4.4-slim

FROM ${BUN_IMAGE} AS deps
WORKDIR /app
COPY package.json bun.lock ./
COPY packages/agents/package.json ./packages/agents/package.json
COPY agents/generic/package.json ./agents/generic/package.json
COPY agents/poet/package.json ./agents/poet/package.json
COPY apps/extract/package.json ./apps/extract/package.json
COPY apps/service/package.json ./apps/service/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN bun install --frozen-lockfile --production

FROM ${BUN_IMAGE} AS runtime
WORKDIR /app/apps/web
ENV NODE_ENV=production

COPY --from=deps /app/node_modules /app/node_modules
COPY package.json /app/package.json
COPY apps/web /app/apps/web
COPY --from=deps /app/apps/web/node_modules /app/apps/web/node_modules

USER bun
EXPOSE 3001
CMD ["bun", "src/index.ts"]
