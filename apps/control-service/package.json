{
  "name": "@stage/control-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "start": "bun --env-file=../../.env --preload ./src/telemetry-init.ts src/index.ts",
    "dev": "bun --env-file=../../.env --preload ./src/telemetry-init.ts --hot src/index.ts",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@elysiajs/openapi": "^1.4.17",
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/pubsub": "^6.4.1",
    "@google-cloud/run": "^4.2.0",
    "@google/adk": "^2.5.0",
    "@sinclair/typebox": "^0.34.52",
    "@stage/agents": "workspace:*",
    "@stage/http": "workspace:*",
    "elysia": "^1.4.32",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
