{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",

  "sortImports": {},
  "sortTailwindcss": { "stylesheet": "./apps/ui/src/index.css", "functions": ["cn", "cva"] },
  "sortPackageJson": true,

  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "**/coverage/**"]
}
